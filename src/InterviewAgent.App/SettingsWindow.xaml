<Window x:Class="InterviewAgent.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="680"
        Height="800"
        MinWidth="620"
        MinHeight="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="服务与隐私设置"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="凭据使用 Windows 当前用户密钥加密。留空表示保留已有值，应用不会回显密钥。"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,7,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="DemoModeCheckBox"
                                  Content="启用演示模式（推荐先体验）"
                                  FontWeight="SemiBold"
                                  FontSize="15" />
                        <TextBlock Text="演示模式不发送音频和问题到云端，仍可导入面经并生成本地演示答案。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="24,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="回答模型（OpenAI 兼容）"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="可连接 DeepSeek、通义千问、Moonshot、智谱、OpenAI、Ollama、LM Studio 等提供 OpenAI Chat Completions 兼容接口的服务。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,5,0,0" />
                        <TextBlock x:Name="ModelSavedLabel"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,12" />

                        <TextBlock Text="模型提供商（显示名称）"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ProviderTextBox"
                                 Margin="0,7,0,12"
                                 MaxLength="80"
                                 ToolTip="例如：DeepSeek、通义千问、Ollama" />

                        <TextBlock Text="Model Name"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ModelNameTextBox"
                                 Margin="0,7,0,12"
                                 MaxLength="200"
                                 ToolTip="填写接口要求的精确模型标识，例如 deepseek-chat 或 qwen-plus" />

                        <TextBlock Text="Base URL"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ModelBaseUrlTextBox"
                                 Margin="0,7,0,5"
                                 MaxLength="2048"
                                 ToolTip="可填写 API 根地址，或完整的 /chat/completions 地址" />
                        <TextBlock Text="远程地址必须使用 HTTPS；本机 Ollama / LM Studio 可使用 localhost HTTP。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="API Key（本地模型可留空）"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="ModelApiKeyPasswordBox"
                                     Margin="0,7,0,12"
                                     MaxLength="512" />

                        <TextBlock Text="最大输出 Token"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ModelMaxTokensTextBox"
                                 Margin="0,7,0,0"
                                 MaxLength="4"
                                 ToolTip="范围：64–8192" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="火山引擎实时语音识别"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="VolcanoSavedLabel"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,12" />

                        <TextBlock Text="新版控制台 API Key"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="VolcanoApiKeyPasswordBox"
                                     Margin="0,7,0,12"
                                     MaxLength="512" />

                        <TextBlock Text="旧版控制台 App ID（可选）"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="VolcanoAppKeyPasswordBox"
                                     Margin="0,7,0,12"
                                     MaxLength="512" />

                        <TextBlock Text="旧版控制台 Access Token（可选）"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="VolcanoAccessKeyPasswordBox"
                                     Margin="0,7,0,12"
                                     MaxLength="512" />

                        <TextBlock Text="Resource ID"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ResourceIdTextBox"
                                 Margin="0,7,0,0"
                                 MaxLength="128" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ClearCredentialsCheckBox"
                          Content="清除所有已保存的 API Key / Token（保留模型地址等配置）"
                          Foreground="{StaticResource DangerBrush}"
                          Margin="4,16,0,0" />
                <TextBlock x:Name="ValidationMessage"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="4,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="取消"
                    Style="{StaticResource SoftButton}"
                    Width="90"
                    Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="加密保存"
                    Style="{StaticResource PrimaryButton}"
                    Width="110"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
