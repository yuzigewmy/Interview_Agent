<Window x:Class="InterviewAgent.App.FloatingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InterviewAgent.App.Controls"
        Title="Interview Agent 悬浮球"
        Width="72"
        Height="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closed="OnClosed"
        MouseLeftButtonDown="OnBallMouseDown"
        MouseMove="OnBallMouseMove"
        MouseLeftButtonUp="OnBallMouseUp">
    <Window.Resources>
        <Style x:Key="MicrophoneStroke" TargetType="Path">
            <Setter Property="Stroke" Value="#DC2626" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter Property="Stroke" Value="#16A34A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid ToolTip="{Binding CaptureHint}"
          AutomationProperties.Name="{Binding CaptureButtonText}">
        <Border CornerRadius="999"
                Background="#DDF2FF"
                BorderBrush="#79BFE8"
                BorderThickness="2">
            <Grid>
                <controls:AudioWaveView Level="{Binding AudioLevel}"
                                        IsActive="{Binding IsCapturing}"
                                        IsHitTestVisible="False" />

                <Grid IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28*" />
                        <ColumnDefinition Width="44*" />
                        <ColumnDefinition Width="28*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28*" />
                        <RowDefinition Height="44*" />
                        <RowDefinition Height="28*" />
                    </Grid.RowDefinitions>
                <Viewbox Grid.Row="1"
                         Grid.Column="1"
                         Stretch="Uniform">
                    <Grid Width="24" Height="24">
                        <Path Style="{StaticResource MicrophoneStroke}"
                              Data="M12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 Z" />
                        <Path Style="{StaticResource MicrophoneStroke}"
                              Data="M6.5,10.5 C6.5,13.54 8.96,16 12,16 C15.04,16 17.5,13.54 17.5,10.5 M12,16 L12,20 M9,20 L15,20" />
                        <Path Data="M5,4 L19,19"
                              Stroke="#DC2626"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Viewbox>
                </Grid>
            </Grid>
        </Border>

        <Thumb x:Name="ResizeThumb"
               Width="18"
               Height="18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,2,2"
               Cursor="SizeNWSE"
               ToolTip="拖动调整悬浮球大小"
               AutomationProperties.Name="调整悬浮球大小"
               DragDelta="OnResizeDragDelta"
               DragCompleted="OnResizeDragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M4,13 L13,4 M8,14 L14,8"
                              Stroke="#3B82B4"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              Opacity="0.72" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
