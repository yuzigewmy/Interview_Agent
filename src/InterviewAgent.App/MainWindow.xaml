<Window x:Class="InterviewAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview Agent"
        Width="1180"
        Height="790"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closed="OnClosed"
        SourceInitialized="OnSourceInitialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#14213D"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            Background="#2563EB"
                            CornerRadius="10"
                            Margin="0,0,12,0">
                        <TextBlock Text="IA"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Interview Agent"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="实时听题 · 本地面经优先 · 五秒内开始回答"
                                   Foreground="#AFC0DA"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#213252"
                            CornerRadius="14"
                            Padding="11,6"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding ModeLabel}" Foreground="#DCE7F8" FontSize="12" />
                    </Border>
                    <Border Background="#173C37"
                            CornerRadius="14"
                            Padding="11,6"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding AsrLabel}" Foreground="#B9F3DF" FontSize="12" />
                    </Border>
                    <Border Background="#203A58"
                            CornerRadius="14"
                            Padding="11,6"
                            Margin="0,0,14,0">
                        <TextBlock Text="{Binding ModelLabel}"
                                   Foreground="#CDE4FF"
                                   FontSize="12"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ModelLabel}" />
                    </Border>
                    <CheckBox x:Name="TopmostCheckBox"
                              Content="窗口置顶"
                              Foreground="#DCE7F8"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Click="OnTopmostClick" />
                    <Button Content="设置"
                            Style="{StaticResource SoftButton}"
                            Click="OnOpenSettingsClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,20,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.42*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.58*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="听题与转写"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Left" />
                            <TextBlock Text="手动控制"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <TextBlock Grid.Row="1"
                                   Text="音频来源"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,7" />
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding AudioDevices}"
                                      SelectedItem="{Binding SelectedAudioDevice}"
                                      DisplayMemberPath="DisplayName"
                                      MinHeight="38"
                                      Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    Padding="0"
                                    Style="{StaticResource SoftButton}"
                                    IsEnabled="{Binding CanRefreshAudioDevices}"
                                    ToolTip="刷新音频来源"
                                    AutomationProperties.Name="刷新音频来源"
                                    Click="OnRefreshAudioDevicesClick">
                                <TextBlock Text="&#xE72C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="3" Margin="0,0,0,14">
                            <Button Content="{Binding CaptureButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="15"
                                    Padding="18,13"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnToggleCaptureClick" />
                            <TextBlock Text="{Binding CaptureHint}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="问题文本（可编辑）"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,7" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding Transcript, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     MinHeight="145"
                                     MaxLength="2000"
                                     ToolTip="语音转写后可在此修正问题，也可直接输入问题。" />
                        </Grid>

                        <Button Grid.Row="5"
                                Content="使用文本生成回答"
                                Style="{StaticResource SoftButton}"
                                FontWeight="SemiBold"
                                Padding="16,11"
                                Margin="0,14,0,0"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="OnAskClick" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="本地面经知识库"
                                       FontWeight="SemiBold"
                                       FontSize="15" />
                            <TextBlock Text="{Binding KnowledgeStatus}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,5,10,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="导入 DOCX"
                                Style="{StaticResource SoftButton}"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="OnImportKnowledgeClick" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="候选人回答"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,4,20,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button Content="导出记录"
                                    Style="{StaticResource SoftButton}"
                                    Margin="0,0,8,0"
                                    Padding="12,6"
                                    IsEnabled="{Binding CanExportInterview}"
                                    ToolTip="将本次面试的全部问题与回答导出为 DOCX"
                                    Click="OnExportInterviewClick" />
                            <Border Background="#EEF4FF"
                                    CornerRadius="12"
                                    Padding="10,6">
                                <TextBlock Text="{Binding TimingText}"
                                           Foreground="#175CD3"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#FAFCFF"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">
                        <Grid>
                            <TextBlock Text="回答会在这里流式出现。未配置云服务时，演示模式仍会根据本地面经生成答案。"
                                       Foreground="#98A2B3"
                                       TextWrapping="Wrap"
                                       FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Answer}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding Answer}"
                                           TextWrapping="Wrap"
                                           FontSize="16"
                                           LineHeight="29"
                                           Foreground="#182230" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="引用来源"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       DockPanel.Dock="Left" />
                            <TextBlock Text="只显示本地命中，不上传原文档"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Evidence}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F5FA"
                                            CornerRadius="7"
                                            Padding="10,7"
                                            Margin="0,0,8,7"
                                            MaxWidth="270"
                                            ToolTip="{Binding Content}">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11"
                                                   Foreground="#344054"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="245" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#EAF0F7"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="隐私：音频与短期问答上下文仅在内存中处理，程序退出即清除；诊断日志不记录问题正文、答案、音频或密钥。"
                           Foreground="#475467"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,18,0" />
                <TextBlock Grid.Column="1"
                           Text="请在参与者同意并符合当地法律、公司与面试平台政策时使用。"
                           Foreground="#667085"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
